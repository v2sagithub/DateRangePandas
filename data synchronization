import pandas as pd
from sqlalchemy import create_engine
from arcgis.features import FeatureLayer
from arcgis.gis import GIS
from arcgis.features import Feature
import json
import pickle
import os
from typing import Optional, Set, Dict, List, Tuple
import logging

# Configure logging
logging.basicConfig(level=logging.INFO, format='%(asctime)s - %(levelname)s - %(message)s')
logger = logging.getLogger(__name__)

class SQLData:
    """Class to handle SQL database connections and data fetching."""
    def __init__(self, config: Dict):
        self.config = config["sql"]
        self.connection_string = (
            f"postgresql://{self.config['user']}:{self.config['password']}@"
            f"{self.config['host']}:{self.config['port']}/{self.config['database']}"
        )
        self.data = None

    def fetch_data(self) -> Optional[pd.DataFrame]:
        """Fetch data from SQL database."""
        try:
            engine = create_engine(self.connection_string)
            self.data = pd.read_sql(self.config["query"], engine)
            logger.info(f"Fetched {self.data.shape[0]} records from SQL table '{self.config['table']}'.")
            return self.data
        except Exception as e:
            logger.error(f"Error fetching SQL data: {e}")
            return None

class ESRIData:
    """Class to handle ESRI feature layer connections, data fetching, and edits."""
    def __init__(self, config: Dict):
        self.config = config["esri"]
        self.key_column = config["comparison"]["key_column"]
        self.compare_columns = config["comparison"]["compare_columns"]
        self.gis = None
        self.feature_layer = None
        self.data = None

    def connect(self) -> bool:
        """Initialize GIS and FeatureLayer connection."""
        try:
            self.gis = GIS("https://www.arcgis.com", self.config["arcgis_username"], self.config["arcgis_password"])
            self.feature_layer = FeatureLayer(self.config["feature_layer_url"], self.gis)
            capabilities = self.feature_layer.properties.get("capabilities", "").lower()
            if not ("edit" in capabilities or "create" in capabilities or "delete" in capabilities):
                logger.error("ESRI feature layer does not support editing.")
                return False
            logger.info("Successfully connected to ESRI feature layer.")
            return True
        except Exception as e:
            logger.error(f"Error initializing ESRI connection: {e}")
            return False

    def fetch_data(self) -> Optional[pd.DataFrame]:
        """Fetch data from ESRI feature layer."""
        try:
            out_fields = [self.key_column] + self.compare_columns
            feature_set = self.feature_layer.query(where="1=1", out_fields=",".join(out_fields))
            self.data = feature_set.sdf[out_fields]
            logger.info(f"Fetched {self.data.shape[0]} records from ESRI feature layer.")
            return self.data
        except Exception as e:
            logger.error(f"Error fetching ESRI data: {e}")
            return None

    def insert_missing_records(self, df_sql: pd.DataFrame, missing_ids: Set) -> bool:
        """Insert missing records into ESRI feature layer with type='Inbox'."""
        try:
            df_missing = df_sql[df_sql[self.key_column].astype(str).isin(missing_ids)]
            if df_missing.empty:
                logger.info("No records to insert.")
                return True

            features_to_add = []
            for _, row in df_missing.iterrows():
                attributes = {
                    self.key_column: row[self.key_column],
                    "type": "Inbox"
                }
                for col in self.compare_columns:
                    attributes[col] = row[col] if pd.notna(row[col]) else None
                feature = Feature(attributes=attributes)
                features_to_add.append(feature)

            result = self.feature_layer.edit_features(adds=features_to_add)
            if result["addResults"]:
                success = all(r["success"] for r in result["addResults"])
                if success:
                    logger.info(f"Successfully inserted {len(features_to_add)} records into ESRI feature layer.")
                    return True
                else:
                    errors = [r["error"] for r in result["addResults"] if not r["success"]]
                    logger.error(f"Failed to insert some records: {errors}")
                    return False
            else:
                logger.error("No add results returned.")
                return False
        except Exception as e:
            logger.error(f"Error inserting records into ESRI: {e}")
            return False

    def delete_extra_records(self, extra_ids: Set) -> bool:
        """Delete records from ESRI feature layer that are missing in SQL."""
        try:
            df_extra = self.data[self.data[self.key_column].astype(str).isin(extra_ids)]
            if df_extra.empty:
                logger.info("No records to delete.")
                return True

            object_ids = df_extra["OBJECTID"].astype(str).tolist()
            result = self.feature_layer.edit_features(deletes=object_ids)
            if result["deleteResults"]:
                success = all(r["success"] for r in result["deleteResults"])
                if success:
                    logger.info(f"Successfully deleted {len(object_ids)} records from ESRI feature layer.")
                    return True
                else:
                    errors = [r["error"] for r in result["deleteResults"] if not r["success"]]
                    logger.error(f"Failed to delete some records: {errors}")
                    return False
            else:
                logger.error("No delete results returned.")
                return False
        except Exception as e:
            logger.error(f"Error deleting records from ESRI: {e}")
            return False

class DataComparator:
    """Class to compare SQL and ESRI datasets."""
    def __init__(self, key_column: str, compare_columns: List[str]):
        self.key_column = key_column
        self.compare_columns = compare_columns

    def compare(self, df_sql: pd.DataFrame, df_esri: pd.DataFrame) -> Tuple[Set, Set, pd.DataFrame]:
        """Compare SQL and ESRI datasets."""
        try:
            # Ensure consistent column names and types
            df_sql = df_sql[[self.key_column] + self.compare_columns].copy()
            df_esri = df_esri[[self.key_column] + self.compare_columns].copy()

            # Convert key column to string
            df_sql[self.key_column] = df_sql[self.key_column].astype(str)
            df_esri[self.key_column] = df_esri[self.key_column].astype(str)

            # Identify missing records
            sql_ids = set(df_sql[self.key_column])
            esri_ids = set(df_esri[self.key_column])
            missing_in_esri = sql_ids - esri_ids
            missing_in_sql = esri_ids - sql_ids

            logger.info(f"Records in SQL but not in ESRI: {len(missing_in_esri)}")
            logger.info(f"Records in ESRI but not in SQL: {len(missing_in_sql)}")

            # Merge datasets
            df_merged = pd.merge(df_sql, df_esri, on=self.key_column, suffixes=("_sql", "_esri"), how="inner")
            logger.info(f"Matching家长 records: {len(df_merged)}")

            # Compare attribute values
            differences = []
            for _, row in df_merged.iterrows():
                for col in self.compare_columns:
                    val_sql = row[f"{col}_sql"]
                    val_esri = row[f"{col}_esri"]
                    if pd.isna(val_sql) and pd.isna(val_esri):
                        continue
                    if val_sql != val_esri:
                        differences.append({
                            "id": row[self.key_column],
                            "column": col,
                            "sql_value": val_sql,
                            "esri_value": val_esri
                        })

            df_differences = pd.DataFrame(differences)
            logger.info(f"Total attribute differences: {len(df_differences)}")

            return missing_in_esri, missing_in_sql, df_differences
        except Exception as e:
            logger.error(f"Error comparing datasets: {e}")
            return set(), set(), pd.DataFrame()

class ChangeWriter:
    """Class to write comparison results to JSON or Pickle files."""
    def __init__(self, output_dir: str = "output"):
        self.output_dir = output_dir
        os.makedirs(self.output_dir, exist_ok=True)

    def write_json(self, data: Dict, filename: str) -> bool:
        """Write data to a JSON file."""
        try:
            filepath = os.path.join(self.output_dir, filename)
            with open(filepath, 'w') as f:
                json.dump(data, f, indent=2, default=str)
            logger.info(f"Successfully wrote data to {filepath}")
            return True
        except Exception as e:
            logger.error(f"Error writing JSON to {filename}: {e}")
            return False

    def write_pickle(self, data: Dict, filename: str) -> bool:
        """Write data to a Pickle file."""
        try:
            filepath = os.path.join(self.output_dir, filename)
            with open(filepath, 'wb') as f:
                pickle.dump(data, f)
            logger.info(f"Successfully wrote data to {filepath}")
            return True
        except Exception as e:
            logger.error(f"Error writing Pickle to {filename}: {e}")
            return False

    def save_changes(self, missing_in_esri: Set, missing_in_sql: Set, differences: pd.DataFrame, format: str = "json") -> bool:
        """Save comparison results to file."""
        try:
            data = {
                "missing_in_esri": list(missing_in_esri),
                "missing_in_sql": list(missing_in_sql),
                "differences": differences.to_dict(orient="records")
            }
            filename = f"comparison_results.{format}"
            if format == "json":
                return self.write_json(data, filename)
            elif format == "pickle":
                return self.write_pickle(data, filename)
            else:
                logger.error(f"Unsupported format: {format}")
                return False
        except Exception as e:
            logger.error(f"Error saving changes: {e}")
            return False

def load_config(config_file: str) -> Optional[Dict]:
    """Load and validate configuration from a JSON file."""
    try:
        if not os.path.exists(config_file):
            logger.error(f"Configuration file {config_file} not found.")
            return None

        with open(config_file, 'r') as f:
            config = json.load(f)

        required_keys = {
            "sql": ["host", "port", "database", "user", "password", "table", "query"],
            "esri": ["feature_layer_url", "arcgis_username", "arcgis_password"],
            "comparison": ["key_column", "compare_columns"]
        }

        for section, keys in required_keys.items():
            if section not in config:
                logger.error(f"Missing section '{section}' in configuration.")
                return None
            for key in keys:
                if key not in config[section]:
                    logger.error(f"Missing key '{key}' in section '{section}'.")
                    return None

        if not config["comparison"]["compare_columns"]:
            logger.error("compare_columns must not be empty.")
            return None

        logger.info("Successfully loaded configuration.")
        return config
    except json.JSONDecodeError as e:
        logger.error(f"Error parsing JSON file: {e}")
        return None
    except Exception as e:
        logger.error(f"Error loading configuration: {e}")
        return None

def main():
    """Main function to orchestrate data comparison and synchronization."""
    CONFIG_FILE = "config.json"
    OUTPUT_FORMAT = "json"  # or "pickle"

    # Load configuration
    config = load_config(CONFIG_FILE)
    if config is None:
        logger.error("Failed to load configuration. Exiting.")
        return

    # Initialize classes
    sql_data = SQLData(config)
    esri_data = ESRIData(config)
    comparator = DataComparator(config["comparison"]["key_column"], config["comparison"]["compare_columns"])
    writer = ChangeWriter()

    # Connect to ESRI
    if not esri_data.connect():
        logger.error("Failed to connect to ESRI. Exiting.")
        return

    # Fetch data
    df_sql = sql_data.fetch_data()
    df_esri = esri_data.fetch_data()

    if df_sql is None or df_esri is None:
        logger.error("Failed to fetch data from one or both sources. Exiting.")
        return

    # Initial comparison
    missing_in_esri, missing_in_sql, df_differences = comparator.compare(df_sql, df_esri)

    # Save initial comparison results
    writer.save_changes(missing_in_esri, missing_in_sql, df_differences, format=OUTPUT_FORMAT)

    # Insert missing records
    if missing_in_esri:
        logger.info("Inserting missing records into ESRI...")
        success = esri_data.insert_missing_records(df_sql, missing_in_esri)
        if not success:
            logger.warning("Insertion failed. Proceeding with original data.")

    # Delete extra records
    if missing_in_sql:
        logger.info("Deleting extra records from ESRI...")
        success = esri_data.delete_extra_records(missing_in_sql)
        if not success:
            logger.warning("Deletion failed. Proceeding with original data.")

    # Re-fetch ESRI data and compare again
    logger.info("Re-fetching ESRI data for final comparison...")
    df_esri_updated = esri_data.fetch_data()
    if df_esri_updated is not None:
        missing_in_esri, missing_in_sql, df_differences = comparator.compare(df_sql, df_esri_updated)
        writer.save_changes(missing_in_esri, missing_in_sql, df_differences, format=OUTPUT_FORMAT)
        logger.info(f"Final comparison results saved to output/comparison_results.{OUTPUT_FORMAT}")
    else:
        logger.error("Failed to re-fetch ESRI data. Original results retained.")

if __name__ == "__main__":
    main()